# 复制为 .env 后修改。生产环境务必更换 DJANGO_SECRET_KEY。
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,222.204.244.237,mathlf2.lflab.cn
DJANGO_CSRF_TRUSTED_ORIGINS=http://222.204.244.237:8000,http://mathlf2.lflab.cn:8000

# 数据库：默认 SQLite（单班规模足够）。如需 PostgreSQL，可填写下面两项。
# DB_ENGINE=postgres
# DB_NAME=dip_competition
# DB_USER=dip
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# 通过 Caddy/Nginx 启用 HTTPS 后设为 1（开启安全 Cookie、HSTS 与跳转）
DJANGO_HTTPS=0

# 站点对外地址（用于邮件/提示中的链接拼接）
SITE_BASE_URL=http://222.204.244.237:8000
